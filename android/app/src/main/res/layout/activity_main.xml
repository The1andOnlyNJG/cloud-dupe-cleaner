<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/cdcBg"
    android:fillViewport="true"
    android:padding="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/eyebrow"
            android:textAllCaps="true"
            android:textColor="?attr/cdcAccent"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/headline"
                android:textColor="?attr/cdcText"
                android:textSize="34sp" />
            <Button
                android:id="@+id/theme_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_ghost"
                android:contentDescription="@string/theme_toggle"
                android:minHeight="48dp"
                android:text="@string/theme_light"
                android:textAllCaps="false"
                android:textColor="?attr/cdcText" />
        </LinearLayout>

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textColor="?attr/cdcMuted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/setup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/setup_title"
            android:padding="16dp"
            android:text="@string/setup_body"
            android:textColor="?attr/cdcText" />

        <TextView
            android:id="@+id/offline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:text="@string/offline"
            android:textColor="?attr/cdcDanger"
            android:visibility="gone" />

        <TextView
            android:id="@+id/error_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:textColor="?attr/cdcDanger"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/accounts"
            android:textColor="?attr/cdcText"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/providers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />

        <Button
            android:id="@+id/scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_primary"
            android:contentDescription="@string/scan"
            android:minHeight="48dp"
            android:text="@string/scan"
            android:textAllCaps="false"
            android:textColor="?attr/cdcAccentInk" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/scan_progress"
            android:max="100"
            android:visibility="gone" />
        <TextView
            android:id="@+id/progress_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/cdcMuted"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/savings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/space_label"
                android:textAllCaps="true"
                android:textColor="?attr/cdcMuted"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/savings_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/cdcText"
                android:textSize="36sp" />
            <TextView
                android:id="@+id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/cdcMuted" />
        </LinearLayout>

        <TextView
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="@string/empty_connect"
            android:textColor="?attr/cdcMuted" />

        <LinearLayout
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp" />
    </LinearLayout>
</ScrollView>
