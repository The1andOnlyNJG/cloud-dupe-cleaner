{
  "name": "cloud-dupe-cleaner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Find duplicate files across Dropbox, OneDrive, Google Drive, and Google Photos, then move extras to trash.",
  "scripts": {
    "start": "node src/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.21",
    "esbuild": "^0.25.5",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "typescript": "^5.8.3"
  }
}
