# Copy to .env and fill in only what you use. Never commit .env.
# Generate keys with: openssl rand -base64 32

PORT=3000
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:3000
NODE_ENV=development

# true uses built-in sample files and does not call cloud APIs.
MOCK_PROVIDERS=true

# Encrypt tokens on disk only when this is true AND TOKEN_ENCRYPTION_KEY is set.
# The default keeps tokens in server memory and writes nothing to disk.
PERSIST_TOKENS=false
SESSION_SIGNING_KEY=
TOKEN_ENCRYPTION_KEY=

# Server-side OAuth client credentials. Leave blank in demo mode.
# Public PKCE clients can omit the secrets. Secrets never go to the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
